# Скопируйте в legacy/.env (этот файл не коммитится).
# ВАЖНО: если стек уже запускался, MySQL уже создан со старыми паролями —
# впишите сюда ТЕ ЖЕ значения, что были в YAML (MM_ROOT_PASSWORD / MM_MMUSER_PASSWORD),
# иначе Mattermost не подключится к базе.
# MYSQL_ROOT_PASSWORD должен совпадать с GitHub Secret DB_MYSQL_ROOT_PASSWORD.
# Пароли — только буквы и цифры (они подставляются в URL подключения).
MYSQL_ROOT_PASSWORD=MM_ROOT_PASSWORD
MYSQL_PASSWORD=MM_MMUSER_PASSWORD
